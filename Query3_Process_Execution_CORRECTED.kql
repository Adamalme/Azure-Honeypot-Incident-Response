// Query 3: Suspicious Process Execution (CORRECTED FOR DEFENDER)
// Purpose: Identify command-line tool usage indicating reconnaissance and lateral movement
// Tools Detected: cmd.exe, powershell.exe, whoami.exe, tasklist.exe, ipconfig.exe, net.exe
// MITRE ATT&CK: T1059 (Command and Scripting Interpreter)
// Duration: August 30 - September 15, 2026
// Results Expected: 149+ suspicious processes
// CORRECTED: Using FileName and ProcessCommandLine fields

DeviceProcessEvents
| where DeviceName contains "sql-labuser"
| where Timestamp between (datetime(2026-08-30) .. datetime(2026-09-15))
| where ProcessCommandLine has_any (
    "powershell.exe",
    "cmd.exe",
    "whoami",
    "tasklist",
    "ipconfig",
    "net user",
    "net group",
    "quser",
    "systeminfo",
    "wmic"
)
| summarize 
    ExecutionCount = count(),
    UniqueUsers = dcount(AccountName),
    UniqueProcesses = dcount(FileName),
    FirstExecution = min(Timestamp),
    LastExecution = max(Timestamp),
    ProcessNames = make_set(FileName),
    CommandLines = make_set(ProcessCommandLine)
    by DeviceName, AccountName
| order by ExecutionCount desc
| project 
    Device = DeviceName,
    User = AccountName,
    TotalExecutions = ExecutionCount,
    UniqueProcesses,
    FirstExecution,
    LastExecution,
    ProcessesList = ProcessNames
