// Query 3: Suspicious Process Execution
// Purpose: Identify command-line tool usage indicating reconnaissance and lateral movement
// Tools Detected: cmd.exe, powershell.exe, whoami.exe, tasklist.exe, ipconfig.exe, net.exe
// MITRE ATT&CK: T1059 (Command and Scripting Interpreter)
// Duration: August 30 - September 15, 2026
// Results Expected: 149+ suspicious processes

DeviceProcessEvents
| where TimeGenerated between (datetime(2026-08-30) .. datetime(2026-09-15))
| where ProcessName in (
    "cmd.exe",
    "powershell.exe",
    "powershell",
    "whoami.exe",
    "tasklist.exe",
    "ipconfig.exe",
    "net.exe",
    "net1.exe",
    "systeminfo.exe",
    "wmic.exe"
    )
    or CommandLine has_any ("whoami", "ipconfig", "tasklist", "net user", "net group", "quser", "systeminfo")
| summarize 
    ExecutionCount = count(),
    UniqueUsers = dcount(AccountName),
    UniqueProcesses = dcount(ProcessName),
    FirstExecution = min(TimeGenerated),
    LastExecution = max(TimeGenerated),
    ProcessNames = make_set(ProcessName),
    CommandLines = make_set(CommandLine)
    by DeviceName, AccountName
| order by ExecutionCount desc
| project 
    Device = DeviceName,
    User = AccountName,
    TotalExecutions = ExecutionCount,
    UniqueProcesses,
    FirstExecution,
    LastExecution,
    ProcessesList = ProcessNames
