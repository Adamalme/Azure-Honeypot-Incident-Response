// Query 6: Registry Modification & Evidence Destruction
// Purpose: Detect registry persistence mechanisms and evidence destruction
// MITRE ATT&CK: T1547 (Boot or Logon Autostart Execution), T1562 (Impair Defenses)
// Duration: August 30 - September 15, 2026
// Results Expected: 2,747 registry events | 8,012 deletions | 729 creations
// Key Finding: Massive registry deletion indicates intentional evidence destruction

DeviceRegistryEvents
| where TimeGenerated between (datetime(2026-08-30) .. datetime(2026-09-15))
| extend 
    IsPersistencePath = iff(RegistryKey has_any (
        "Run",
        "RunOnce",
        "Services",
        "Winlogon",
        "Startup",
        "LSA",
        "AppInit_DLLs"
    ), 1, 0),
    IsEvidenceDestruction = iff(ActionType == "RegistryKeyDeleted" or ActionType == "RegistryValueDeleted", 1, 0)
| summarize 
    TotalRegistryEvents = count(),
    KeysCreated = countif(ActionType == "RegistryKeyCreated"),
    KeysDeleted = countif(ActionType == "RegistryKeyDeleted"),
    ValuesSet = countif(ActionType == "RegistryValueSet"),
    ValuesDeleted = countif(ActionType == "RegistryValueDeleted"),
    PersistenceAttempts = countif(IsPersistencePath == 1),
    EvidenceDestruction = countif(IsEvidenceDestruction == 1),
    FirstActivity = min(TimeGenerated),
    LastActivity = max(TimeGenerated),
    RegistryPaths = make_set(RegistryKey)
    by DeviceName, AccountName, ActionType
| order by TotalRegistryEvents desc
| project 
    Device = DeviceName,
    User = AccountName,
    Action = ActionType,
    TotalEvents = TotalRegistryEvents,
    KeysCreated,
    KeysDeleted,
    ValuesSet,
    ValuesDeleted,
    PersistenceMechanisms = PersistenceAttempts,
    EvidenceDestructionAttempts = EvidenceDestruction,
    FirstActivity,
    LastActivity
