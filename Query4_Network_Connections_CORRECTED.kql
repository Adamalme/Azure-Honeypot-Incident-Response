// Query 4: Network Connections Analysis (CORRECTED FOR DEFENDER)
// Purpose: Identify all outbound network traffic and C2 communication attempts
// MITRE ATT&CK: T1071 (Application Layer Protocol)
// Duration: August 30 - September 15, 2026
// Results Expected: 1,642 network events

DeviceNetworkEvents
| where DeviceName contains "sql-labuser"
| where Timestamp between (datetime(2026-08-30) .. datetime(2026-09-15))
| where RemotePort in (80, 443, 8080, 8443, 53, 22, 3389, 445, 139)
    or RemoteIPType == "Public"
| extend 
    IsC2Traffic = iff(RemoteIPType == "Public" and RemotePort in (443, 80, 8080, 8443), 1, 0),
    ProtocolType = case(
        RemotePort == 443, "HTTPS",
        RemotePort == 80, "HTTP",
        RemotePort == 53, "DNS",
        RemotePort == 22, "SSH",
        RemotePort == 3389, "RDP",
        RemotePort in (139, 445), "SMB",
        "OTHER"
    )
| summarize 
    TotalConnections = count(),
    UniqueRemoteIPs = dcount(RemoteIP),
    FirstSeen = min(Timestamp),
    LastSeen = max(Timestamp)
    by RemoteIP, RemotePort, ProtocolType, RemoteUrl
| order by TotalConnections desc
| project 
    RemoteIP,
    RemotePort,
    Protocol = ProtocolType,
    TotalConnections,
    FirstSeen,
    LastSeen,
    URL = RemoteUrl
| limit 50
