// Query 7: Master Timeline - Complete Attack Reconstruction
// Purpose: Correlate all event types into chronological timeline showing complete attack chain
// Duration: August 30 - September 15, 2026
// Results Expected: 69,191 total events
// Methodology: Union of logon, process, file, and registry events to reconstruct complete incident

let LogonEvents = DeviceLogonEvents
| where TimeGenerated between (datetime(2026-08-30) .. datetime(2026-09-15))
| project TimeGenerated, EventType = "Logon", Details = strcat(AccountName, " - ", ActionType), DeviceName, RemoteIP, ActionType;

let ProcessEvents = DeviceProcessEvents
| where TimeGenerated between (datetime(2026-08-30) .. datetime(2026-09-15))
| project TimeGenerated, EventType = "Process", Details = strcat(ProcessName, " - ", CommandLine), DeviceName, RemoteIP = "", ActionType;

let FileEvents = DeviceFileEvents
| where TimeGenerated between (datetime(2026-08-30) .. datetime(2026-09-15))
| project TimeGenerated, EventType = "File", Details = strcat(FolderPath, FileName, " - ", ActionType), DeviceName, RemoteIP = "", ActionType;

let RegistryEvents = DeviceRegistryEvents
| where TimeGenerated between (datetime(2026-08-30) .. datetime(2026-09-15))
| project TimeGenerated, EventType = "Registry", Details = strcat(RegistryKey, " - ", ActionType), DeviceName, RemoteIP = "", ActionType;

union LogonEvents, ProcessEvents, FileEvents, RegistryEvents
| order by TimeGenerated asc
| extend DateOnly = format_datetime(TimeGenerated, "yyyy-MM-dd")
| project 
    TimeGenerated,
    Date = DateOnly,
    EventType,
    Details,
    Device = DeviceName,
    RemoteIP = iff(RemoteIP != "", RemoteIP, "Local"),
    Action = ActionType
| extend AttackPhase = case(
    TimeGenerated between (datetime(2026-08-30) .. datetime(2026-08-31)), "Phase 1: Brute Force",
    TimeGenerated between (datetime(2026-09-01) .. datetime(2026-09-08)), "Phase 2: Exploitation",
    TimeGenerated between (datetime(2026-09-08) .. datetime(2026-09-11)), "Phase 3: Persistence",
    TimeGenerated between (datetime(2026-09-11) .. datetime(2026-09-14)), "Phase 4: Evidence Destruction",
    TimeGenerated between (datetime(2026-09-14) .. datetime(2026-09-15)), "Phase 5: Egress",
    "Unknown"
)
| project TimeGenerated, Date, AttackPhase, EventType, Action, Details, Device, RemoteIP
