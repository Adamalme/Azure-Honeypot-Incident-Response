// Query 7: Master Timeline - Complete Attack Reconstruction (CORRECTED FOR DEFENDER)
// Purpose: Correlate all event types into chronological timeline showing complete attack chain
// Duration: August 30 - September 15, 2026
// Results Expected: 69,191 total events
// Methodology: Union of logon, process, file, and registry events to reconstruct complete incident

let LogonEvents = DeviceLogonEvents
| where DeviceName contains "sql-labuser"
| where Timestamp between (datetime(2026-08-30) .. datetime(2026-09-15))
| project Timestamp, EventType = "Logon", Details = strcat(AccountName, " - ", ActionType), DeviceName, RemoteIP, ActionType;

let ProcessEvents = DeviceProcessEvents
| where DeviceName contains "sql-labuser"
| where Timestamp between (datetime(2026-08-30) .. datetime(2026-09-15))
| project Timestamp, EventType = "Process", Details = strcat(FileName, " - ", ProcessCommandLine), DeviceName, RemoteIP = "", ActionType;

let FileEvents = DeviceFileEvents
| where DeviceName contains "sql-labuser"
| where Timestamp between (datetime(2026-08-30) .. datetime(2026-09-15))
| project Timestamp, EventType = "File", Details = strcat(FolderPath, FileName, " - ", ActionType), DeviceName, RemoteIP = "", ActionType;

let RegistryEvents = DeviceRegistryEvents
| where DeviceName contains "sql-labuser"
| where Timestamp between (datetime(2026-08-30) .. datetime(2026-09-15))
| project Timestamp, EventType = "Registry", Details = strcat(RegistryKey, " - ", ActionType), DeviceName, RemoteIP = "", ActionType;

union LogonEvents, ProcessEvents, FileEvents, RegistryEvents
| order by Timestamp asc
| extend DateOnly = format_datetime(Timestamp, "yyyy-MM-dd")
| project 
    Timestamp,
    Date = DateOnly,
    EventType,
    Details,
    Device = DeviceName,
    RemoteIP = iff(RemoteIP != "", RemoteIP, "Local"),
    Action = ActionType
| extend AttackPhase = case(
    Timestamp between (datetime(2026-08-30) .. datetime(2026-08-31)), "Phase 1: Brute Force",
    Timestamp between (datetime(2026-09-01) .. datetime(2026-09-08)), "Phase 2: Exploitation",
    Timestamp between (datetime(2026-09-08) .. datetime(2026-09-11)), "Phase 3: Persistence",
    Timestamp between (datetime(2026-09-11) .. datetime(2026-09-14)), "Phase 4: Evidence Destruction",
    Timestamp between (datetime(2026-09-14) .. datetime(2026-09-15)), "Phase 5: Egress",
    "Unknown"
)
| project Timestamp, Date, AttackPhase, EventType, Action, Details, Device, RemoteIP
