// Query 1: MySQL Malicious Commands
// Purpose: Identify SQL commands executed against the MySQL database during the attack
// Duration: August 30 - September 15, 2026
// Results Expected: 221 malicious SQL commands

MySQLAudit_CL
| where TimeGenerated between (datetime(2026-08-30) .. datetime(2026-09-15))
| where sql_command_s has_any ("DROP", "DELETE", "TRUNCATE", "ALTER", "GRANT", "REVOKE", "CREATE USER", "SET GLOBAL")
    or status_s != "Success"
    or user_name_s !in ("admin", "system", "root")
| summarize 
    TotalCommands = count(),
    FailedAttempts = countif(status_s != "Success"),
    UniqueUsers = dcount(user_name_s),
    CommandTypes = make_set(sql_command_s)
    by tostring(TimeGenerated),
    user_name_s,
    sql_command_s,
    database_name_s
| order by TimeGenerated desc
| project 
    TimeGenerated,
    User = user_name_s,
    Database = database_name_s,
    Command = sql_command_s,
    Status = status_s,
    IPAddress = client_ip_s
